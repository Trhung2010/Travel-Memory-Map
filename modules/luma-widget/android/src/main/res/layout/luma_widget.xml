<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="#171B22">
  <ImageView android:id="@+id/luma_photo" android:layout_width="match_parent"
    android:layout_height="0dp" android:layout_weight="1"
    android:scaleType="centerCrop" android:contentDescription="Khoảnh khắc mới nhất" />
  <TextView android:id="@+id/luma_label" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="9dp"
    android:text="LUMA · Mở để đồng bộ" android:textColor="#F3D3A0"
    android:textSize="12sp" android:background="#171B22" />
</LinearLayout>
